# THEeye - Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8000
DEBUG=false
HOST=0.0.0.0

# Security
SECRET_KEY=change-this-to-a-random-secret-key

# Demo/Admin Account Credentials (only used on first startup)
DEMO_EMAIL=demo@theeye.local
DEMO_PASSWORD=demo123
ADMIN_EMAIL=admin@theeye.local
ADMIN_PASSWORD=admin123

# Contact email for polite API pools (OpenAlex, Crossref)
CONTACT_EMAIL=your-email@institution.edu

# Semantic Scholar API key (optional, for higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=
